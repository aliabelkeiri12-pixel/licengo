{
  "name": "licengo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @licengo/web dev",
    "build": "pnpm --filter @licengo/web build",
    "test": "pnpm -r test",
