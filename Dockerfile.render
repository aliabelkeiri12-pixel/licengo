# syntax=docker/dockerfile:1.7
# Image "tout-en-un" pour hébergement PaaS (Render) : migration + initialisation + serveur au démarrage.
FROM node:22-bookworm
RUN corepack enable
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY apps/web/prisma apps/web/prisma
COPY packages/core/package.json packages/core/package.json
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    pnpm install --frozen-lockfile --filter @licengo/web... --filter @licengo/core
COPY packages/core packages/core
COPY apps/web apps/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    pnpm --filter @licengo/web exec prisma generate && pnpm --filter @licengo/web exec next build \
 && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static \
 && cp -r apps/web/public apps/web/.next/standalone/apps/web/public
ENV NODE_ENV=production PORT=10000 HOSTNAME=0.0.0.0 STORAGE_DIR=/data/storage
WORKDIR /app/apps/web
EXPOSE 10000
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm exec tsx prisma/bootstrap.ts && node .next/standalone/apps/web/server.js"]
