{
  "name": "@licengo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@licengo/core": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.70.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
